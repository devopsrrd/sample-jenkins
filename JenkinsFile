pipeline {
    agent {label 'build-agent'}

    stages {
        stage('Build') {
            steps {
                echo 'Building...'        
                sh 'whoami'       
                sh '/home/ubuntu/apache-maven-3.9.9/bin/mvn clean install -DskipTests'
            }
        }
        stage('Create Docker Image') {
            steps {
                echo 'Create Docker Image'
                sh 'sudo docker build -t springboot:1.0.0 .'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying....'
                sh 'sudo docker run -d -p 8082:8080 springboot:1.0.0'
            }
        }
    }
}
